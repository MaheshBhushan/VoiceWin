<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>voicewin</AssemblyName>
    <RootNamespace>VoiceWin</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Linux Speech-to-Text Transcription App (VoiceWin port)</Description>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="Deepgram" Version="6.6.1" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the portable (non-Windows) code from the WPF project -->
    <Compile Include="../VoiceWin/Models/AppSettings.cs" Link="Models/AppSettings.cs" />
    <Compile Include="../VoiceWin/Models/TranscriptionResult.cs" Link="Models/TranscriptionResult.cs" />
    <Compile Include="../VoiceWin/Services/GroqTranscriptionService.cs" Link="Services/GroqTranscriptionService.cs" />
    <Compile Include="../VoiceWin/Services/GroqLlmService.cs" Link="Services/GroqLlmService.cs" />
    <Compile Include="../VoiceWin/Services/DeepgramTranscriptionService.cs" Link="Services/DeepgramTranscriptionService.cs" />
    <Compile Include="../VoiceWin/Services/DeepgramStreamingService.cs" Link="Services/DeepgramStreamingService.cs" />
    <Compile Include="../VoiceWin/Services/SettingsService.cs" Link="Services/SettingsService.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../VoiceWin/Assets/vwtrans-crop.png" Link="Assets/vwtrans-crop.png" />
    <EmbeddedResource Include="../VoiceWin/Assets/sound_start.mp3" LogicalName="VoiceWin.Assets.sound_start.mp3" />
    <EmbeddedResource Include="../VoiceWin/Assets/sound_end.mp3" LogicalName="VoiceWin.Assets.sound_end.mp3" />
  </ItemGroup>

</Project>
